# Server only. Never prefix these variables with VITE_.
# Create your key in Google AI Studio; never commit the filled .env file.
GEMINI_API_KEY=
# Exact text-generation model available to your Google project.
GEMINI_MODEL=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Optional. Leave empty until you have a defensible scenario and source.
# All coefficients: grams CO2e / 1,000 tokens. Not per prompt or per token.
EMISSION_MODEL=
EMISSION_FACTOR_VERSION=
EMISSION_FACTOR_SOURCE=
EMISSION_SYSTEM_BOUNDARY=
EMISSION_INPUT_G_PER_1K=
EMISSION_OUTPUT_G_PER_1K=
EMISSION_THINKING_G_PER_1K=
EMISSION_CACHED_G_PER_1K=
